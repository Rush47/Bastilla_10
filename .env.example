# Czat używa wyłącznie istniejącego, lokalnego modelu Dolphin 8B uncensored.
# Kod nie pobiera modeli, nie instaluje Ollamy ani nie wybiera mniejszego modelu.
LLM_PROVIDERS="ollama"
OLLAMA_MODEL="dolphin-llama3:8b"
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_KEEP_ALIVE="24h"
OLLAMA_NUM_CTX="4096"
OLLAMA_NUM_THREAD=""
OLLAMA_NUM_PREDICT="3072"
LLM_TIMEOUT_SEC="360"
CHAT_LOCAL_FALLBACK="off"
BEST_FIT_ROUTER="on"

# ── Inne Zmienne Środowiskowe ───────────────────────────────────────────────
POLLINATIONS_API_KEY="MY_POLLINATIONS_API_KEY"
APP_URL="MY_APP_URL"
PORT="3000"


# ── OpenAI image generation (optional, separately billed API) ──
# Set as a deployment secret; never commit a real key.
OPENAI_API_KEY=""
OPENAI_IMAGE_MODEL="gpt-image-1"

# Maximum incoming request body size in MiB (1-1024, default 1024).
# Base64 file attachments increase request size by about 33%.
BASTILLA_UPLOAD_MAX_MB=1024

# Required for state-changing agent task endpoints; use a fresh random secret (32+ characters).
BASTILLA_AGENT_TASKS_TOKEN=""

# GPT Actions (REST, no MCP). Disabled until both values are set.
# Public HTTPS origin only, e.g. https://your-deployed-app.example
GPT_ACTIONS_PUBLIC_URL=""
# Set a fresh random secret (32+ characters) in deployment secrets, never in git.
GPT_ACTIONS_TOKEN=""

# Public Firebase client configuration for this deployment (never a service-account key).
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""

